-- 7) TRIGGERS
-- 7.1: Antes de insertar detalle de orden: verificar stock suficiente
DELIMITER $$
CREATE TRIGGER trg_before_insert_detalleorden
BEFORE INSERT ON DetalleOrden
FOR EACH ROW
BEGIN
    DECLARE v_stock INT;
    SELECT stock INTO v_stock FROM Productos WHERE id_producto = NEW.id_producto FOR UPDATE;
    IF v_stock IS NULL THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Producto inexistente';
    END IF;
    IF v_stock < NEW.cantidad THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Stock insuficiente para el producto';
    END IF;
END $$

-- 7.2: Después de insertar detalle de orden: descontar stock
CREATE TRIGGER trg_after_insert_detalleorden
AFTER INSERT ON DetalleOrden
FOR EACH ROW
BEGIN
    UPDATE Productos SET stock = stock - NEW.cantidad WHERE id_producto = NEW.id_producto;
END $$

-- 7.3: Después de insertar Factura: si es producto y tiene id_orden, recalcular monto (seguridad)
CREATE TRIGGER trg_after_insert_factura
AFTER INSERT ON Facturas
FOR EACH ROW
BEGIN
    DECLARE v_total DECIMAL(12,2);
    IF NEW.id_orden IS NOT NULL THEN
        SELECT COALESCE(SUM(cantidad * precio_unitario),0) INTO v_total FROM DetalleOrden WHERE id_orden = NEW.id_orden;
        IF NEW.monto_total <> v_total THEN
            UPDATE Facturas SET monto_total = v_total WHERE id_factura = NEW.id_factura;
        END IF;
    END IF;
END $$

DELIMITER ;

