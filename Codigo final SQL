-- 4) VISTAS útiles
-- 4.1: Clientes con su servicio activo (si tienen)
CREATE OR REPLACE VIEW v_clientes_servicio AS
SELECT c.id_cliente, CONCAT(c.nombre,' ',c.apellido) AS cliente, c.email, c.telefono, c.direccion,
       n.descripcion AS nacionalidad,
       sc.id_servicio, p.nombre_plan, p.velocidad_mb, p.precio_mensual, sc.fecha_alta, sc.estado
FROM Clientes c
LEFT JOIN Nacionalidades n ON c.id_nacionalidad = n.id_nacionalidad
LEFT JOIN ServiciosContratados sc ON c.id_cliente = sc.id_cliente
LEFT JOIN Planes p ON sc.id_plan = p.id_plan;

-- Objetivo: ofrecer un tablero con clientes y su servicio asociado (si lo tienen).
-- Tablas: Clientes, Nacionalidades, ServiciosContratados, Planes

-- 4.2: Facturación mensual por año
CREATE OR REPLACE VIEW v_facturacion_mensual AS
SELECT YEAR(f.fecha_emision) AS anio, MONTH(f.fecha_emision) AS mes, 
       SUM(f.monto_total) AS total_mes, COUNT(*) AS facturas_mes
FROM Facturas f
GROUP BY YEAR(f.fecha_emision), MONTH(f.fecha_emision)
ORDER BY anio, mes;

-- Objetivo: resumen mensual de facturación.
-- Tablas: Facturas

-- 4.3: Productos con stock bajo (umbral = 5)
CREATE OR REPLACE VIEW v_productos_stock_bajo AS
SELECT id_producto, nombre, stock, precio
FROM Productos
WHERE stock <= 5;

-- Objetivo: identificar productos para reponer.
-- Tablas: Productos

-- 4.4: Ordenes con detalles y totales calculados
CREATE OR REPLACE VIEW v_ordenes_detalle_total AS
SELECT o.id_orden, o.id_cliente, CONCAT(c.nombre,' ',c.apellido) AS cliente, o.fecha_compra, o.estado,
       SUM(do.cantidad * do.precio_unitario) AS total_orden,
       COUNT(do.id_detalle) AS items
FROM Ordenes o
JOIN Clientes c ON o.id_cliente = c.id_cliente
LEFT JOIN DetalleOrden do ON o.id_orden = do.id_orden
GROUP BY o.id_orden;

-- Objetivo: vista para ver resumen de ordenes con su total.
-- Tablas: Ordenes, Clientes, DetalleOrden

-- 4.5: Clientes con saldo pendiente (factura sin pago total)
CREATE OR REPLACE VIEW v_clientes_saldo_pendiente AS
SELECT f.id_factura, f.id_cliente, CONCAT(c.nombre,' ',c.apellido) AS cliente, f.monto_total,
       COALESCE(SUM(p.monto),0) AS total_pagado,
       (f.monto_total - COALESCE(SUM(p.monto),0)) AS saldo_pendiente
FROM Facturas f
JOIN Clientes c ON f.id_cliente = c.id_cliente
LEFT JOIN Pagos p ON f.id_factura = p.id_factura
GROUP BY f.id_factura
HAVING saldo_pendiente > 0;

-- Objetivo: listar facturas con saldo pendiente.
-- Tablas: Facturas, Clientes, Pagos

-- 5) FUNCIONES (MySQL)
DELIMITER $$

-- 5.1: Función que calcula el total de una orden sumando su detalle
CREATE FUNCTION fn_total_orden(p_id_orden INT) RETURNS DECIMAL(12,2)
DETERMINISTIC
BEGIN
    DECLARE v_total DECIMAL(12,2) DEFAULT 0;
    SELECT COALESCE(SUM(cantidad * precio_unitario),0) INTO v_total
    FROM DetalleOrden WHERE id_orden = p_id_orden;
    RETURN v_total;
END $$

-- 5.2: Función que devuelve el estado del servicio activo de un cliente (primero que aparece)
CREATE FUNCTION fn_estado_servicio_cliente(p_id_cliente INT) RETURNS VARCHAR(50)
DETERMINISTIC
BEGIN
    DECLARE v_estado VARCHAR(50) DEFAULT 'Sin servicio';
    SELECT sc.estado INTO v_estado FROM ServiciosContratados sc
    WHERE sc.id_cliente = p_id_cliente
    ORDER BY sc.fecha_alta DESC LIMIT 1;
    IF v_estado IS NULL THEN
        RETURN 'Sin servicio';
    END IF;
    RETURN v_estado;
END $$

-- 5.3: Función que devuelve el saldo pendiente total de un cliente (sum de facturas - pagos)
CREATE FUNCTION fn_saldo_pendiente_cliente(p_id_cliente INT) RETURNS DECIMAL(12,2)
DETERMINISTIC
BEGIN
    DECLARE v_total_facturas DECIMAL(12,2) DEFAULT 0;
    DECLARE v_total_pagos DECIMAL(12,2) DEFAULT 0;
    SELECT COALESCE(SUM(monto_total),0) INTO v_total_facturas FROM Facturas WHERE id_cliente = p_id_cliente;
    SELECT COALESCE(SUM(p.monto),0) INTO v_total_pagos FROM Pagos p JOIN Facturas f ON p.id_factura = f.id_factura WHERE f.id_cliente = p_id_cliente;
    RETURN v_total_facturas - v_total_pagos;
END $$

DELIMITER ;

