-- 6) STORED PROCEDURES (MySQL)
DELIMITER $$

-- 6.1: Generar factura por servicio (usa precio del plan)
CREATE PROCEDURE sp_generar_factura_servicio(IN p_id_servicio INT)
BEGIN
    DECLARE v_cliente INT;
    DECLARE v_plan INT;
    DECLARE v_precio DECIMAL(12,2);
    DECLARE v_fecha DATE;
    SELECT id_cliente, id_plan INTO v_cliente, v_plan FROM ServiciosContratados WHERE id_servicio = p_id_servicio;
    SELECT precio_mensual INTO v_precio FROM Planes WHERE id_plan = v_plan;
    SET v_fecha = CURDATE();
    INSERT INTO Facturas (id_cliente, fecha_emision, monto_total, tipo, id_servicio, id_orden)
    VALUES (v_cliente, v_fecha, v_precio, 'Servicio', p_id_servicio, NULL);
END $$

-- Objetivo: automatizar la facturación recurrente de un servicio mensual.
-- Tablas: ServiciosContratados, Planes, Facturas

-- 6.2: Registrar orden con detalles (y actualizar stock)
-- Parámetros: cliente, fecha, estado. Los detalles se pasan por una tabla temporal temporal_detalle(id_producto, cantidad, precio_unitario)
-- Nota: en MySQL real, podrías usar JSON o tablas temporales. Para simplicidad se asume que existe una tabla temporal `tmp_detalle` creada por el cliente antes de llamar.
CREATE PROCEDURE sp_registrar_orden_con_detalle(IN p_id_cliente INT, IN p_fecha DATE, IN p_estado VARCHAR(20))
BEGIN
    DECLARE v_id_orden INT;
    INSERT INTO Ordenes (id_cliente, fecha_compra, estado) VALUES (p_id_cliente, p_fecha, p_estado);
    SET v_id_orden = LAST_INSERT_ID();
    -- Si existe tabla temporal tmp_detalle, insertarla
    IF (SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = 'tmp_detalle') > 0 THEN
        INSERT INTO DetalleOrden(id_orden, id_producto, cantidad, precio_unitario)
        SELECT v_id_orden, id_producto, cantidad, precio_unitario FROM tmp_detalle;
        -- Actualizar stock
        UPDATE Productos p JOIN (
            SELECT id_producto, SUM(cantidad) AS total_cant FROM tmp_detalle GROUP BY id_producto
        ) t ON p.id_producto = t.id_producto
        SET p.stock = p.stock - t.total_cant;
        -- Borrar tmp_detalle
        DROP TABLE IF EXISTS tmp_detalle;
    END IF;
END $$

-- Objetivo: facilitar la creación de ordenes y su detalle desde procesos externos (web, API).
-- Tablas: Ordenes, DetalleOrden, Productos

-- 6.3: Registrar pago y validar si factura queda saldada
CREATE PROCEDURE sp_registrar_pago(IN p_id_factura INT, IN p_fecha_pago DATE, IN p_monto DECIMAL(12,2), IN p_metodo VARCHAR(50))
BEGIN
    INSERT INTO Pagos (id_factura, fecha_pago, monto, metodo_pago) VALUES (p_id_factura, p_fecha_pago, p_monto, p_metodo);
    -- Opcional: lógica de notificación o cambio de estado de la factura si monto cubre total (no tenemos campo estado en facturas por simplicidad)
END $$

